{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sync.sh pull >/dev/null 2>&1 || true", "timeout": 30 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "(nohup \"$CLAUDE_PROJECT_DIR\"/scripts/sync.sh >>\"$CLAUDE_PROJECT_DIR\"/.sync.log 2>&1 &) ; true" } ] }
    ]
  }
}
