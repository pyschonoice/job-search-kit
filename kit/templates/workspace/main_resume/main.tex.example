  \small +00-0000000000 \textbullet\ \href{mailto:you@example.com}{you@example.com} \textbullet\ \href{https://linkedin.com/in/you}{linkedin.com/in/you} \textbullet\ \href{https://github.com/you}{github.com/you} \textbullet\ City, Country
\end{center}

% Summary
\section{Summary}
\small One or two lines: your role, your strongest verified proof, one real number.

% Skills
\section{Skills}
\small
\textbf{Languages:} A, B, C \\
\textbf{Frameworks:} D, E \\
\textbf{Data \& Infra:} F, G \\
