\begin{itemize}[leftmargin=*, nosep, topsep=1pt]
  \resumeItem{Built X that did Y, measured as Z (a number that is true).}
  \resumeItem{Second bullet.}
\end{itemize}

% Projects
\section{Projects}
\resumeSubheading{Project name}{Year}{Stack, Stack}{link}
